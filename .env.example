BASE_URL=http://127.0.0.1:1234/v1
API_KEY=
MODEL=google/gemma-4-26b-a4b
TEMPERATURE=0.4

VOICE=am_puck
SPEED=1.08
KOKORO_MODEL=kokoro-v1.0.onnx
KOKORO_VOICES=voices-v1.0.bin
ONNX_PROVIDER=CUDAExecutionProvider

PROMPT_FILE=prompt.txt
REASONING_EFFORT=none

WEATHER_CITY=Sibiu
WEATHER_LAT=45.7983
WEATHER_LON=24.1256

WHISPER_MODEL=turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=float16
# Optional: PulseAudio source name; defaults to a connected Bluetooth mic, else the system default
MIC_DEVICE=

# Long-term memory service on the Mac mini (see README); leave MEMORY_URL empty to turn memory off
MEMORY_URL=
MEMORY_TOKEN=

# Music through Riff (see README, "Music"): the client ID of your Spotify developer app.
# Leave empty to keep only pause/skip/volume (no search or playing by name).
SPOTIFY_CLIENT_ID=

# HEARING-WORKAROUND(respeaker): 1 while the laptop mic hears the music (only short music
# commands count, and spoken turns are cut at 15 s while Riff plays). Pair it with
# MIC_DEVICE=appy_echo_cancel_source from bin/appy-echo-cancel. See docs/hearing-workaround.md.
APPY_MIC_HEARS_MUSIC=
